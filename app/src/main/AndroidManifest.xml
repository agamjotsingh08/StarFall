<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:label="Starfall"
        android:icon="@drawable/ic_starfall" android:theme="@style/GameTheme"
        android:hardwareAccelerated="true" android:supportsRtl="true" android:enableOnBackInvokedCallback="true">
        <!-- Portrait is intentional for the fixed shooter arena; resizing still letterboxes safely. -->
        <activity android:name=".MainActivity" android:exported="true" tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:screenOrientation="portrait" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
